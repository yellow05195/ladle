# Ladle app: public build settings (copy to .env.local, or set them in Vercel).
# Every NEXT_PUBLIC_ value is baked into the build and shipped to every
# browser: never put a secret here. Change one, then redeploy.

# demo (simulated in the browser, what useladle.fun runs today) | chain
NEXT_PUBLIC_DATA_SOURCE=demo

# --- chain mode only -------------------------------------------------------

# mainnet-beta | devnet (devnet when unset). Drives the explorer links
# (?cluster=devnet only on devnet) and the footer's source line.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Required on mainnet-beta: a paid RPC (HTTP). Its key is visible in the
# browser: restrict it to the site's origin (https://useladle.fun) in the
# provider's dashboard. That only stops other websites (a script can send any
# Origin header): give it a hard spending cap and a rate limit, and keep the
# keeper's key on another account or plan so abuse of this one cannot starve
# the keeper. Unset on devnet: the public devnet endpoint is used.
NEXT_PUBLIC_RPC_URL=

# Optional: the provider's websocket, when it is not the RPC url with wss://.
# Viewers read rounds through account and log subscriptions, with a slow
# fallback poll (about 4 RPC calls a minute per open tab).
NEXT_PUBLIC_RPC_WS_URL=

# Optional: the program id (the sdk's PULLED_PROGRAM_ID when unset).
NEXT_PUBLIC_LADLE_PROGRAM=

# Required in chain mode: the market PDA, `market` in config/deployments/<cluster>.json
# (written by scripts/devnet-up.ps1 / scripts/mainnet-up.ps1).
# Unset or wrong, the hall says "Rounds can't be read right now." with the reason.
NEXT_PUBLIC_LADLE_MARKET=

# Round chat relay (wss://...); unset in chain mode, the chat is off. See docs/CHAT.md.
NEXT_PUBLIC_LADLE_CHAT_URL=

# Optional: the profile registry (not built yet). Unset in chain mode, profiles carry no Genesis number.
NEXT_PUBLIC_PROFILE_API=
