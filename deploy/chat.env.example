# /etc/ladle/chat.env (root:root 0600, read by systemd only): CHAT_RESUME_SECRET is a secret.
# scripts/mainnet-up.ps1 writes a filled-in copy (random secret) to
# %USERPROFILE%\.config\ladle\chat.env. Every setting: docs/CHAT.md.
CHAT_HOST=127.0.0.1
CHAT_PORT=8787
CHAT_PUBLIC_HOST=chat.useladle.fun
CHAT_ORIGINS=https://useladle.fun,https://www.useladle.fun
CHAT_TRUST_PROXY=1
CHAT_MUTE_FILE=/var/lib/ladle/mute.txt
# 32 random bytes, e.g. openssl rand -hex 32; keep it across restarts so pages resume their sign-in
CHAT_RESUME_SECRET=REPLACE
