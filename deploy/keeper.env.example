# /etc/ladle/keeper.env (root:root 0600, read by systemd only): it holds the RPC key.
# scripts/mainnet-up.ps1 (mainnet) and scripts/devnet-up.ps1 (devnet) write a
# filled-in copy to %USERPROFILE%\.config\ladle\. Every setting: keeper/README.md.
LADLE_CLUSTER=mainnet-beta
# the SERVER key of your RPC, restricted to this VPS's IP address
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE
LADLE_PROGRAM=85ig2nch9XBAeGbdhj613vipBufxsw1eWH4Eyw7QbgFj
LADLE_MARKET=REPLACE_WITH_THE_MARKET_ADDRESS
# the treasury the program was built with (LADLE_TREASURY of the build)
LADLE_TREASURY=REPLACE_WITH_YOUR_TREASURY_PUBLIC_KEY
KEEPER_KEYPAIR=/etc/ladle/keeper.json
# priority fee: auto = recent fees on the accounts written, floor 1000, cap 100000 micro-lamports per compute unit
KEEPER_CU_PRICE=auto
KEEPER_CU_PRICE_MAX=100000
KEEPER_HEALTH_PORT=8788
KEEPER_ALERT_BELOW_SOL=0.2
# optional: a Discord or Slack incoming-webhook URL for low-balance and stalled-keeper alerts
KEEPER_ALERT_WEBHOOK=
# optional: open no new round past this many ORAO requests in 24 h (0 or unset = no cap; a 2-minute
# market runs at most ~720 rounds a day). Sealing, finalizing and refunds go on; an alert says so.
KEEPER_VRF_PER_DAY=0
# shutting down (scripts/mainnet-recover.ps1): set to 1 and restart; no new round opens, every round
# is finished or refunded and closed, then the keeper exits by itself (log line "drained")
KEEPER_DRAIN=0
